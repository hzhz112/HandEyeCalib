# Bytecode. The committed .cpython-314.pyc files were left behind by a stray
# Python 3.14 run; nothing here is source.
__pycache__/
*.py[cod]
*$py.class

# Collected calibration sessions: PNG frames plus samples.json. Machine and
# pose specific, and regenerated by every collection run. Force-add a specific
# session (`git add -f handeye_data/session_.../`) if one is worth publishing.
handeye_data/

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments. The conda env `acurb` lives outside the tree, but a local venv
# may appear next to the code.
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/

# Editors and OS cruft
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
